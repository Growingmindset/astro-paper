---
import Page from "@/layouts/Page.astro";
import { SITE } from "@/config";
---

<Page
  title={`Terms of service | ${SITE.title}`}
  description="Terms for Risk On shop purchases."
>
  <h1 class="page-title">Terms of service</h1>
  <div class="prose-block essay-body">
    <p>By purchasing from Risk On, you agree to the following:</p>
    <ul>
      <li>
        All sales are final except in cases of product defect (see our Return
        Policy).
      </li>
      <li>
        Prices are listed in USD and are subject to change without notice.
      </li>
      <li>
        We reserve the right to refuse or cancel any order at our discretion,
        including in cases of suspected fraud.
      </li>
      <li>
        Product images are for illustrative purposes; actual colors may vary
        slightly due to screen settings and print processes.
      </li>
      <li>
        Risk On is a project of Growth State of Mind LLC, operating under the
        assumed name "Risk On."
      </li>
      <li>These terms are governed by the laws of the State of Texas.</li>
    </ul>
    <p>
      Questions? Contact us at <a href="mailto:growingstateofmind@gmail.com"
        >growingstateofmind@gmail.com</a
      >.
    </p>
  </div>
  <p class="after-list">
    <a class="text-link" href="/nonzero#shop">Back to the shop</a>
  </p>
</Page>
