---
import Page from "@/layouts/Page.astro";
import { SITE } from "@/config";
---

<Page title={`Page not found | ${SITE.title}`}>
  <h1 class="page-title">This page doesn’t exist.</h1>
  <p class="lede-follow">
    It may have moved when the site was simplified. Every essay is listed on the <a
      class="text-link"
      href="/">front page</a
    >, and older posts are in the <a class="text-link" href="/archive"
      >archive</a
    >.
  </p>
</Page>
