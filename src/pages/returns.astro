---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Returns & Refunds | RISK ON">
  <Header activeNav="returns" />
  <main id="main-content" class="text-skin-base mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-6 text-2xl font-bold tracking-wide uppercase">
      Returns & Refunds
    </h1>
    <div class="prose max-w-none space-y-4 prose-invert">
      <p>
        All Risk On apparel is made to order. Because each item is printed
        specifically for you upon purchase, we do not accept returns or
        exchanges for incorrect size, buyer's remorse, or change of mind.
      </p>
      <p>
        If your item arrives damaged, defective, or with a print error, contact
        us at <a href="mailto:growingstateofmind@gmail.com" class="underline"
          >growingstateofmind@gmail.com</a
        > within 14 days of delivery with a photo of the issue. We'll send a free
        replacement or issue a refund.
      </p>
      <p>
        Please allow up to 3–5 business days for production before shipping,
        plus standard shipping time.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
