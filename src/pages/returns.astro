---
import Page from "@/layouts/Page.astro";
import { SITE } from "@/config";
---

<Page
  title={`Returns and refunds | ${SITE.title}`}
  description="Returns and refunds for Risk On orders."
>
  <h1 class="page-title">Returns and refunds</h1>
  <div class="prose-block essay-body">
    <p>
      All Risk On apparel is made to order. Because each item is printed
      specifically for you upon purchase, we do not accept returns or exchanges
      for incorrect size, buyer’s remorse, or change of mind.
    </p>
    <p>
      If your item arrives damaged, defective, or with a print error, contact us
      at <a href="mailto:growingstateofmind@gmail.com"
        >growingstateofmind@gmail.com</a
      > within 14 days of delivery with a photo of the issue. We’ll send a free replacement
      or issue a refund.
    </p>
    <p>
      Please allow up to 3–5 business days for production before shipping, plus
      standard shipping time.
    </p>
  </div>
  <p class="after-list">
    <a class="text-link" href="/nonzero#shop">Back to the shop</a>
  </p>
</Page>
