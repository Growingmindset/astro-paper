---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
---

<Layout title="Links | RISK ON">
  <Header activeNav="links" />
  <main id="main-content" class="mx-auto flex max-w-sm flex-col items-center justify-center px-6 py-16 min-h-[60vh]">
    <!-- Brand Header -->
    <div class="text-center mb-10">
      <h1 class="text-3xl font-extrabold tracking-widest mb-2">RISK ON</h1>
      <p class="text-sm opacity-70 italic">Personal performance for a bold undertaking.</p>
    </div>

    <!-- Link Stack -->
    <div class="w-full flex flex-col gap-4">
      <!-- Primary Commerce Link (High Contrast) -->
      <a 
        href="/shop" 
        class="w-full py-4 text-center font-bold tracking-widest border-2 border-skin-accent text-skin-accent hover:bg-skin-accent hover:text-skin-inverted transition-all duration-300 rounded-md"
      >
        SHOP RISK ON APPAREL
      </a>

      <!-- Secondary Navigation Links -->
      <a 
        href="/" 
        class="w-full py-4 text-center font-medium tracking-wide border border-skin-line hover:border-skin-accent transition-all duration-300 rounded-md"
      >
        Home & Portfolio
      </a>

      <a 
        href="/posts" 
        class="w-full py-4 text-center font-medium tracking-wide border border-skin-line hover:border-skin-accent transition-all duration-300 rounded-md"
      >
        Essays & Writing
      </a>

      <a 
        href="/reviews" 
        class="w-full py-4 text-center font-medium tracking-wide border border-skin-line hover:border-skin-accent transition-all duration-300 rounded-md"
      >
        Book Reviews
      </a>
    </div>
  </main>
  <Footer />
</Layout>
