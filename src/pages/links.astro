---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Links | RISK ON">
  <Header activeNav="links" />
  <main
    id="main-content"
    class="flex flex-col items-center justify-center px-4 py-12"
  >
    <div class="mx-auto flex w-full max-w-sm flex-col items-center">
      <!-- Header Section -->
      <div class="mb-10 flex flex-col items-center text-center">
        <h1
          class="text-skin-base text-4xl font-bold tracking-[0.2em] uppercase"
        >
          RISK ON
        </h1>
        <p class="text-skin-base mt-3 text-sm italic opacity-80">
          Personal performance for a bold undertaking.
        </p>
      </div>

      <!-- Link Stack -->
      <div class="flex w-full flex-col gap-4">
        <a
          href="/shop"
          class="border-skin-accent text-skin-accent hover:bg-skin-accent hover:text-skin-inverted w-full rounded-lg border-2 px-6 py-4 text-center text-sm font-bold tracking-wider uppercase transition-all duration-300"
        >
          SHOP RISK ON APPAREL
        </a>

        <a
          href="/newsletter"
          class="border-skin-line text-skin-base hover:border-skin-accent hover:text-skin-accent w-full rounded-lg border px-6 py-4 text-center text-sm font-medium tracking-wide transition-all duration-300"
        >
          Base Rate (free weekly newsletter)
        </a>

        <a
          href="/nonzero"
          class="border-skin-line text-skin-base hover:border-skin-accent hover:text-skin-accent w-full rounded-lg border px-6 py-4 text-center text-sm font-medium tracking-wide transition-all duration-300"
        >
          Mr. Nonzero (2027 poker year)
        </a>

        <a
          href="/writing"
          class="border-skin-line text-skin-base hover:border-skin-accent hover:text-skin-accent w-full rounded-lg border px-6 py-4 text-center text-sm font-medium tracking-wide transition-all duration-300"
        >
          Writing
        </a>

        <a
          href="/about"
          class="border-skin-line text-skin-base hover:border-skin-accent hover:text-skin-accent w-full rounded-lg border px-6 py-4 text-center text-sm font-medium tracking-wide transition-all duration-300"
        >
          About
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
