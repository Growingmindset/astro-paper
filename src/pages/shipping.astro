---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Shipping | RISK ON">
  <Header activeNav="shipping" />
  <main id="main-content" class="text-skin-base mx-auto max-w-3xl px-4 py-12">
    <h1 class="mb-6 text-2xl font-bold tracking-wide uppercase">Shipping</h1>
    <div class="prose max-w-none space-y-4 prose-invert">
      <p>
        Orders are printed and shipped on demand. Please allow 3–5 business days
        for production, followed by standard shipping (typically 5–8 business
        days within the US). You'll receive a tracking number by email once your
        order ships.
      </p>
      <p>
        Risk On is not responsible for delays caused by the shipping carrier
        once the package has left our fulfillment partner.
      </p>
    </div>
  </main>
  <Footer />
</Layout>
