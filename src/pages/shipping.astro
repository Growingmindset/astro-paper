---
import Page from "@/layouts/Page.astro";
import { SITE } from "@/config";
---

<Page
  title={`Shipping | ${SITE.title}`}
  description="Shipping for Risk On orders."
>
  <h1 class="page-title">Shipping</h1>
  <div class="prose-block essay-body">
    <p>
      Orders are printed and shipped on demand. Please allow 3–5 business days
      for production, followed by standard shipping (typically 5–8 business days
      within the US). You’ll receive a tracking number by email once your order
      ships.
    </p>
    <p>
      Risk On is not responsible for delays caused by the shipping carrier once
      the package has left our fulfillment partner.
    </p>
  </div>
  <p class="after-list">
    <a class="text-link" href="/nonzero#shop">Back to the shop</a>
  </p>
</Page>
