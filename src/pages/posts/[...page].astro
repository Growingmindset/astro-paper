---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

// 1. Get ALL posts meant for The Lab (exclude library and archive)
const labPosts = sortedPosts.filter((post) => {
  const tags = post.data.tags || [];
  return tags.includes("lab") || (!tags.includes("library") && !tags.includes("archive"));
});

// 2. Separate into Living Documents (Top Section)
const livingDocs = labPosts.filter((post) => {
  const tags = post.data.tags || [];
  return tags.includes("living-document");
});

// 3. Separate into Regular Posts (Bottom Section)
const regularPosts = labPosts.filter((post) => {
  const tags = post.data.tags || [];
  return !tags.includes("living-document");
});

export async function getStaticPaths() {
  return [{ params: { page: undefined } }];
}
---

<Layout title={`The Lab | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-12 border-b border-border text-center">
      <h1 class="text-4xl font-bold">The Lab</h1>
      <p class="mt-4 text-xl text-muted-foreground">
        The Active Grind & Builds. A "Build-in-Public" workspace revealing the raw engineering behind the Human Machine, financial logic, and programmatic systems.
      </p>
    </section>

    {
      livingDocs.length > 0 && (
        <section class="pt-12 pb-8 max-w-4xl mx-auto px-4">
          <h2 class="text-2xl font-semibold mb-6">Living Documents</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {livingDocs.map((post) => <Card variant="h3" {...post} />)}
          </div>
        </section>
      )
    }

    <section class="pt-8 pb-16 max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-semibold mb-6">All Posts</h2>
      <ul class="space-y-6">
        {regularPosts.map((post) => (
          <li><Card variant="h3" {...post} /></li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
