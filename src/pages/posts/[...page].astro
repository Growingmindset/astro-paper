---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

// Living Documents - using post.slug (after getSortedPosts)
const livingDocs = sortedPosts.filter((post) =>
  post.id.includes("2026-human-machine-log") || post.id.includes("2026-portfolio-log")
);

const regularPosts = sortedPosts.filter(
  (post) => !(post.id.includes("2026-human-machine-log") || post.id.includes("2026-portfolio-log"))
);

<Layout title={`The Lab | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="app-layout">
    <!-- The Lab Header -->
    <section class="pt-8 pb-12 border-b border-border">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h1 class="text-4xl font-bold tracking-tight">The Lab</h1>
        <p class="mt-4 text-xl text-muted-foreground">
          Active systems in motion.<br />
          Living documents and ongoing experiments.
        </p>
        <p class="mt-2 text-sm text-muted-foreground">
          This is where the real work happens — updated continuously.
        </p>
      </div>
    </section>

    <!-- Living Documents -->
    {
      livingDocs.length > 0 && (
        <section class="pt-12 pb-8">
          <div class="max-w-4xl mx-auto px-4">
            <h2 class="text-2xl font-semibold mb-6">Living Documents</h2>
            <div class="grid gap-6 md:grid-cols-2">
              {livingDocs.map((post) => (
                <Card variant="h3" {...post} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- All Other Posts -->
    <section class="pt-8 pb-16">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl font-semibold mb-6">All Posts</h2>
        <ul class="space-y-6">
          {regularPosts.map((post) => (
            <li>
              <Card variant="h3" {...post} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
