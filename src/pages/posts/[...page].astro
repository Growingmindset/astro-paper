---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

const livingDocs = sortedPosts.filter((post) =>
  post.id.includes("2026-human-machine-log") || post.id.includes("2026-portfolio-log")
);

const regularPosts = sortedPosts.filter(
  (post) => !(post.id.includes("2026-human-machine-log") || post.id.includes("2026-portfolio-log"))
);

export async function getStaticPaths() {
  return [{}];
}
<Layout title={`The Lab | ${SITE.title}`}>
  <Header />
  <main>
    <section class="pt-8 pb-12 border-b border-border text-center">
      <h1 class="text-4xl font-bold">The Lab</h1>
      <p class="mt-4 text-xl text-muted-foreground">
        Active systems in motion. Living documents and ongoing experiments.
      </p>
    </section>

    {
      livingDocs.length > 0 && (
        <section class="pt-12 pb-8 max-w-4xl mx-auto px-4">
          <h2 class="text-2xl font-semibold mb-6">Living Documents</h2>
          <div class="grid gap-6 md:grid-cols-2">
            {livingDocs.map((post) => <Card variant="h3" {...post} />)}
          </div>
        </section>
      )
    }

    <section class="pt-8 pb-16 max-w-4xl mx-auto px-4">
      <h2 class="text-2xl font-semibold mb-6">All Posts</h2>
      <ul class="space-y-6">
        {regularPosts.map((post) => (
          <li><Card variant="h3" {...post} /></li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
