---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

// 1. Fulfill Astro's requirement for dynamic routes
export async function getStaticPaths() {
  return [{ params: { page: undefined } }];
}

// 2. Fetch posts, excluding drafts
const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

// 3. Define the exact tags used in The Library
const libraryTags = ["transmissions", "deconstructions", "academic-systems"];

// 4. The Firewall: Filter OUT any post that belongs to The Library
const labPosts = sortedPosts.filter((post) => {
  const tags = post.data.tags || [];
  const isLibraryPost = tags.some((tag) => libraryTags.includes(tag));
  return !isLibraryPost;
});

// 5. Separate into Living Documents (Top Section)
const livingDocs = labPosts.filter((post) => {
  const tags = post.data.tags || [];
  return tags.includes("living-document");
});

// 6. Separate into Regular Posts / System Logs (Bottom Section)
const regularPosts = labPosts.filter((post) => {
  const tags = post.data.tags || [];
  return !tags.includes("living-document");
});
---

<Layout title={`The Lab | ${SITE.title}`}>
  <Header activeNav="posts" />

  <main id="main-content" class="app-layout">
    <section class="border-border border-b border-dashed pt-8 pb-10 text-center">
      <h1 class="mb-4 text-3xl font-bold tracking-wider sm:text-4xl">The Lab</h1>
      <p class="text-skin-base mx-auto max-w-2xl leading-relaxed opacity-90">
        Active system deployments. A living workspace documenting the raw
        mechanics of capital allocation, the Human Machine, and programmatic
        logic.
      </p>
    </section>

    {
      livingDocs.length > 0 && (
        <section class="mx-auto max-w-4xl pt-12 pb-8">
          <h2 class="text-skin-accent mb-1 text-2xl font-bold tracking-wide">
            Living Documents
          </h2>
          <p class="text-skin-base mb-0 max-w-2xl text-sm opacity-70">
            Maintained while the cycle is active, archived when it closes. Dates
            below show publication, not last edit.
          </p>
          <ul class="grid list-none grid-cols-1 items-start gap-x-10 gap-y-0 ps-0 md:grid-cols-2">
            {livingDocs.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </section>
      )
    }

    {
      regularPosts.length > 0 && (
        <section class="mx-auto max-w-4xl pt-8 pb-16">
          <h2 class="text-skin-accent mb-2 text-2xl font-bold tracking-wide">
            System Logs
          </h2>
          <ul class="border-skin-line list-none border-l-2 border-opacity-50 ps-6">
            {regularPosts.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </section>
      )
    }
  </main>

  <Footer />
</Layout>