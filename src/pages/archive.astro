---
import Page from "@/layouts/Page.astro";
import { SITE } from "@/config";
import {
  getArchived,
  getPostUrl,
  groupByYear,
  smartQuotes,
} from "@/utils/posts";

const years = groupByYear(await getArchived());
---

<Page
  title={`Archive | ${SITE.title}`}
  description="Older notes, market logs, and retired training programs by Rudy Galan."
>
  <h1 class="page-title">Archive</h1>
  <p class="lede-follow">
    Notes, market logs, book teardowns, and training programs I’ve retired. They
    stay up as a record of what I thought at the time. The essays are on the <a
      class="text-link"
      href="/">front page</a
    >.
  </p>

  {
    years.map(({ year, posts }) => (
      <section class="year-group" aria-label={`Archived posts from ${year}`}>
        <p class="year-label">{year}</p>
        <ul class="essay-list">
          {posts.map(post => (
            <li>
              <a href={getPostUrl(post)}>{smartQuotes(post.data.title)}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Page>
