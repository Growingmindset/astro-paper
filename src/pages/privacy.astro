---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Privacy Policy | RISK ON">
  <Header activeNav="privacy" />
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-12 text-skin-base">
    <h1 class="text-2xl font-bold uppercase tracking-wide mb-6">Privacy Policy</h1>
    <div class="prose prose-invert max-w-none space-y-4">
      <p>We collect only the information necessary to process your order: name, shipping address, email, and payment details.</p>
      <p>Payments are processed securely through Stripe. We do not store your credit card information on our servers.</p>
      <p>Order and shipping information may be shared with our fulfillment partner, Printify, solely to produce and ship your order.</p>
      <p>We do not sell or share your personal information with third parties for marketing purposes.</p>
      <p>If you have questions about your data, contact us at <a href="mailto:growingstateofmind@gmail.com" class="underline">growingstateofmind@gmail.com</a>.</p>
    </div>
  </main>
  <Footer />
</Layout>