---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Training Partner Application">
  <section class="workout-partner">
    <div class="intro">
      <h1>Find a training partner in San Antonio</h1>
<p>
  I'm looking for 2-4 experienced lifters to train with directly — people
  who'll push me and get pushed in return, and build real camaraderie
  along the way. If I've already got my crew, I'll connect you with other
  applicants who match your training age, goals, and schedule instead.
  No app, no algorithm — just people who'll actually show up.
</p>
<p class="note">Takes about 2 minutes. I review every submission personally.</p>
    </div>

    <iframe
      data-tally-src="https://tally.so/embed/81gaEO?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
      loading="lazy"
      width="100%"
      height="1047"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="Training Partner Application"
    ></iframe>
  </section>

  <script is:inline>
    var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
  </script>
</Layout>

<style>
  .workout-partner {
    max-width: 700px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }
  .intro h1 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }
  .intro p {
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .note {
    font-size: 0.9rem;
    opacity: 0.75;
  }
  iframe {
    margin-top: 1.5rem;
    border-radius: 8px;
  }
</style>
