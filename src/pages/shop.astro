---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import { products, lineMeta, lineOrder } from "../data/products";

const sections = lineOrder
  .map(line => ({
    line,
    meta: lineMeta[line],
    items: products.filter(p => p.line === line && p.published),
  }))
  .filter(section => section.items.length > 0);
---

<Layout title="Shop | RISK ON">
  <Header activeNav="shop" />
  <main id="main-content" class="mx-auto max-w-4xl px-4 py-12">
    <div class="mb-6 text-center">
      <h1 class="text-skin-base text-3xl font-bold tracking-[0.15em] uppercase">
        RISK ON SUPPLY
      </h1>
      <p class="text-skin-base mt-2 text-sm opacity-75">
        Made to order. Shipped by Printful.
      </p>
      <p class="text-skin-base mt-2 text-xs opacity-60">
        From the writer behind <a
          href="/newsletter"
          class="underline decoration-dashed underline-offset-4">Base Rate</a
        >
        and <a
          href="/nonzero"
          class="underline decoration-dashed underline-offset-4">Mr. Nonzero</a
        >.
      </p>
    </div>

    <div
      class="text-skin-base mx-auto mb-8 max-w-2xl text-center text-sm leading-relaxed opacity-80"
    >
      <p>
        Risk on is a market term: you're in, you're committed, you're betting on
        yourself. The skill isn't always being in. It's knowing when the odds
        are on your side and committing fully when they are.
      </p>
      <p class="mt-3">
        Same rule in the gym, at the table, and in the market: take the right
        risk at the right time, and size it so you can play again tomorrow.
      </p>
    </div>

    <nav
      class="mb-12 flex flex-wrap items-center justify-center gap-3"
      aria-label="Shop sections"
    >
      {
        sections.map(({ line, meta }) => (
          <a
            href={`#${line}`}
            class="border-skin-line text-skin-base rounded-full border px-4 py-1.5 text-xs font-bold tracking-wide uppercase opacity-70 transition-opacity duration-200 hover:opacity-100"
          >
            {meta.heading}
          </a>
        ))
      }
    </nav>

    {
      sections.map(({ line, meta, items }) => (
        <section id={line} class="mb-16 scroll-mt-24">
          <div class="mb-6 text-center">
            <h2 class="text-skin-base text-xl font-bold tracking-wide uppercase">
              {meta.heading}
            </h2>
            {meta.blurb && (
              <p class="text-skin-base mt-1 text-xs opacity-60">{meta.blurb}</p>
            )}
          </div>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {items.map(product => (
              <ProductCard product={product} />
            ))}
          </div>
        </section>
      ))
    }

    <div class="text-skin-base mt-4 space-x-3 text-center text-xs opacity-50">
      <a href="/terms" class="hover:underline">Terms</a>
      <span>·</span>
      <a href="/returns" class="hover:underline">Returns</a>
      <span>·</span>
      <a href="/shipping" class="hover:underline">Shipping</a>
      <span>·</span>
      <a href="/privacy" class="hover:underline">Privacy</a>
    </div>
  </main>
  <Footer />
</Layout>
