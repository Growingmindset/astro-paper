---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Shop | RISK ON">
  <Header activeNav="shop" />
  <main id="main-content" class="mx-auto max-w-4xl px-4 py-12">
    <div class="mb-10 text-center">
      <h1 class="text-3xl font-bold uppercase tracking-[0.15em] text-skin-base">RISK ON SUPPLY</h1>
      <p class="mt-2 text-sm text-skin-base opacity-75">Built for training. Made by hand.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      <div class="flex flex-col overflow-hidden rounded-lg border border-skin-line bg-skin-fill">
        <img src="/shop/hit-maxes-evade-taxes.png" alt="Hit Maxes, Evade Taxes Tee" class="aspect-square w-full object-cover" />
        <div class="flex flex-1 flex-col p-4">
          <h2 class="text-sm font-semibold text-skin-base">Hit Maxes, Evade Taxes</h2>
          <p class="mt-1 text-sm text-skin-base opacity-70">$29.99</p>
          <a href="https://buy.stripe.com/xxxxxxxxxxxx1" data-astro-reload class="mt-4 rounded-lg border-2 border-skin-accent px-4 py-2 text-center text-xs font-bold uppercase tracking-wider text-skin-accent transition-all duration-300 hover:bg-skin-accent hover:text-skin-inverted">
            Buy Now
          </a>
        </div>
      </div>

      <!--
        TO ADD A NEW DESIGN LATER:
        1. Drop the new photo in public/shop/your-file-name.png
        2. Create a new Stripe Payment Link for it
        3. Copy the entire <div class="flex flex-col overflow-hidden..."> block above,
           paste it here as a sibling, and swap: image src, alt text, product name,
           price, and Stripe link href.
        The grid-cols-2 above will automatically slot it in next to the first card.
      -->
    </div>
  </main>
  <Footer />
</Layout>
