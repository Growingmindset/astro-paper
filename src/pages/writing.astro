---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const live = getSortedPosts(posts).filter(post => !post.data.archived);

const has = (post: (typeof live)[number], tag: string) =>
  (post.data.tags || []).includes(tag);

const libraryTags = ["transmissions", "deconstructions", "academic-systems"];
const isLibrary = (post: (typeof live)[number]) =>
  libraryTags.some(tag => has(post, tag));

const groups = [
  {
    id: "essays",
    name: "Essays",
    description: "Original arguments about money, people, and how they decide.",
    posts: live.filter(p => has(p, "transmissions") || has(p, "academic-systems")),
  },
  {
    id: "deconstructions",
    name: "Deconstructions",
    description: "Taking apart other people's systems: books, products, markets, history.",
    posts: live.filter(p => has(p, "deconstructions") && !has(p, "transmissions")),
  },
  {
    id: "logs",
    name: "Live logs",
    description: "Documents I keep updating while the cycle is active: portfolios, programs, the poker year.",
    posts: live.filter(p => !isLibrary(p) && has(p, "living-document")),
  },
  {
    id: "notes",
    name: "Notes & builds",
    description: "Everything else I'm working on in public.",
    posts: live.filter(p => !isLibrary(p) && !has(p, "living-document")),
  },
].filter(g => g.posts.length > 0);
---

<Layout
  title={`Writing | ${SITE.title}`}
  description="Essays, deconstructions, and live logs by Rudy Galan."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-16">
    <section class="pt-4 pb-6">
      <h1 class="text-3xl font-bold sm:text-4xl">Writing</h1>
      <p class="mt-3 max-w-2xl text-base leading-relaxed">
        Everything I've published, in one place. Weekly market analysis goes
        out in <a href="/newsletter" class="underline decoration-dashed underline-offset-4">Base Rate</a>.
      </p>
      <nav aria-label="Sections" class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {
          groups.map(g => (
            <a href={`#${g.id}`} class="underline decoration-dashed underline-offset-4 hover:text-accent">
              {g.name} ({g.posts.length})
            </a>
          ))
        }
      </nav>
    </section>

    {
      groups.map(g => (
        <section id={g.id} class="border-border border-t border-dashed pt-8 pb-4">
          <h2 class="text-2xl font-semibold tracking-wide">{g.name}</h2>
          <p class="mt-1 text-sm opacity-75">{g.description}</p>
          <ul>
            {g.posts.map(post => (
              <Card {...post} variant="h3" />
            ))}
          </ul>
        </section>
      ))
    }

    <p class="pt-6 text-center text-sm opacity-70">
      Retired programs and closed logs live in the
      <a href="/archive" class="underline">Archive</a>.
    </p>
  </main>
  <Footer />
</Layout>
