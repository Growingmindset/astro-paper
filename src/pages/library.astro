---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

// 1. Fetch posts to see which categories currently have content
const posts = await getCollection("blog", ({ data }) => !data.draft);
const tagsInUse = new Set(posts.flatMap(post => post.data.tags || []));

// 2. The 3-Pillar Master Taxonomy
const categories = [
  {
    id: "transmissions",
    name: "Essays & Observations",
    description:
      "Original philosophies, tactical baselines, and thoughts on human nature.",
    exists: tagsInUse.has("transmissions"),
  },
  {
    id: "deconstructions",
    name: "Deconstructions",
    description:
      "Audits of other systems, book reviews, and historical teardowns.",
    exists: tagsInUse.has("deconstructions"),
  },
];

// 3. Only show categories that actually have posts to prevent dead 404 links
const activeCategories = categories.filter(cat => cat.exists);
---

<Layout title={`The Library | ${SITE.title}`}>
  <Header activeNav="library" />

  <main class="mx-auto w-full max-w-3xl px-4 pb-12">
    <section class="pt-8 pb-10 text-center">
      <h1 class="mb-4 text-3xl font-bold tracking-wider sm:text-4xl">
        The Library
      </h1>
      <p class="text-skin-base mx-auto max-w-2xl leading-relaxed opacity-90">
        First-principles thinking. Essays, observations, deconstructions, and
        academic systems exploring human behavior, operational excellence, and
        physical infrastructure.
      </p>
    </section>

    <section class="mt-4 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        activeCategories.map(cat => {
          return (
            <a
              href={`/tags/${cat.id}/`}
              class="group bg-skin-card border-skin-line hover:border-skin-accent block rounded-xl border p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-md"
            >
              <h2 class="group-hover:text-skin-accent mb-2 text-xl font-bold transition-colors">
                {cat.name}{" "}
                <span class="inline-block transition-transform group-hover:translate-x-1">
                  &rarr;
                </span>
              </h2>
              <p class="text-skin-base text-sm leading-relaxed opacity-80">
                {cat.description}
              </p>
            </a>
          );
        })
      }
    </section>
  </main>

  <Footer />
</Layout>
