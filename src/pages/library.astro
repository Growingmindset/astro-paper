---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

// 1. Fetch posts to see which categories currently have content
const posts = await getCollection("blog", ({ data }) => !data.draft);
const tagsInUse = new Set(posts.flatMap(post => post.data.tags || []));

// 2. The 4-Pillar Master Taxonomy
const categories = [
  {
    id: "transmissions",
    name: "Transmissions",
    description: "Core essays, high-signal field notes, and tactical observations on human nature.",
    exists: tagsInUse.has("transmissions")
  },
  {
    id: "deconstructions",
    name: "Deconstructions",
    description: "Audits of other people's systems. Book reviews, music discographies, and historical events.",
    exists: tagsInUse.has("deconstructions")
  },
  {
    id: "meditations",
    name: "Meditations",
    description: "Deep, internal philosophical writing and physical baselines of the Human Machine.",
    exists: tagsInUse.has("meditations")
  },
  {
    id: "academic-systems",
    name: "Academic Systems",
    description: "Hard university coursework translated into real-world mechanics (Calculus, Physics).",
    exists: tagsInUse.has("academic-systems")
  }
];

// 3. Only show categories that actually have posts to prevent dead 404 links
const activeCategories = categories.filter(cat => cat.exists);
---

<Layout title={`The Library | ${SITE.title}`}>
  <Header activeNav="library" />

  <main class="mx-auto w-full max-w-3xl px-4 pb-12">
    
    <section class="pt-8 pb-10 text-center">
      <h1 class="text-3xl font-bold tracking-wider sm:text-4xl mb-4">The Library</h1>
      <p class="text-skin-base opacity-90 max-w-2xl mx-auto leading-relaxed">
        First-principles thinking. Essays, deconstructions, philosophical meditations, and academic systems exploring human behavior, operational excellence, and physical infrastructure.
      </p>
    </section>

    <section class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {activeCategories.map(cat => (
        <a href={`/tags/${cat.id}/`} class="group block p-6 bg-skin-card border border-skin-line rounded-xl hover:border-skin-accent transition-all duration-300 hover:shadow-md hover:-translate-y-1">
          <h2 class="text-xl font-bold mb-2 group-hover:text-skin-accent transition-colors">
            {cat.name} <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
          </h2>
          <p class="text-sm text-skin-base opacity-80 leading-relaxed">
            {cat.description}
          </p>
        </a>
      ))}
    </section>

  </main>

  <Footer />
</Layout>
