---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

const libraryTags = ["transmissions", "deconstructions", "meditations", "academic-systems", "frameworks"];

const libraryPosts = sortedPosts.filter(post =>
  post.data.tags?.some(tag => libraryTags.includes(tag))
);
---

<Layout title={`The Library | ${SITE.title}`}>
  <Header activeNav="library" />

  <main class="mx-auto w-full max-w-3xl px-4 pb-12">
    
    <section class="pt-8 pb-6 text-center">
      <h1 class="text-3xl font-bold tracking-wider sm:text-4xl mb-4">The Library</h1>
      <p class="text-skin-base opacity-90 max-w-2xl mx-auto leading-relaxed">
        First-principles thinking. Essays, deconstructions, philosophical meditations, academic systems, and cognitive frameworks exploring human behavior, operational excellence, and long-term compounding.
      </p>
    </section>

    <div id="library-filters">
      
      <section class="flex flex-wrap justify-center gap-3 mb-10 border-b border-dashed border-border pb-6">
        <button class="filter-btn active px-4 py-2 text-sm font-medium border border-skin-line rounded bg-skin-accent text-skin-inverted transition-colors" data-filter="all">
          All
        </button>
        <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="transmissions">
          Transmissions
        </button>
        <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="deconstructions">
          Deconstructions
        </button>
        <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="meditations">
          Meditations
        </button>
        <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="academic-systems">
          Academic Systems
        </button>
        <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="frameworks">
          Frameworks
        </button>
      </section>

      <section>
        <ul>
          {libraryPosts.map(post => {
            const mainCategory = post.data.tags?.find(tag => libraryTags.includes(tag)) || "other";
            return (
              <li class="lib-post-item mb-6" data-category={mainCategory}>
                <Card {...post} />
              </li>
            );
          })}
        </ul>
      </section>

    </div>
   
  </main>

  <Footer />
</Layout>

<script is:inline>
  // CRITICAL: Must use astro:page-load to survive View Transitions, not DOMContentLoaded
  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById("library-filters");
    if (!container) return;

    const filterButtons = container.querySelectorAll(".filter-btn");
    const postItems = container.querySelectorAll(".lib-post-item");

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        
        // Reset all buttons
        filterButtons.forEach((btn) => {
          btn.classList.remove("bg-skin-accent", "text-skin-inverted");
          btn.classList.add("text-skin-base", "hover:bg-skin-card");
        });

        // Activate clicked button
        button.classList.add("bg-skin-accent", "text-skin-inverted");
        button.classList.remove("text-skin-base", "hover:bg-skin-card");

        const filterValue = button.getAttribute("data-filter");
        console.log("Filter Executed:", filterValue); // Debug check

        // Filter posts using Tailwind's native 'hidden' class
        postItems.forEach((post) => {
          const category = post.getAttribute("data-category");

          if (filterValue === "all" || category === filterValue) {
            post.classList.remove("hidden");
          } else {
            post.classList.add("hidden");
          }
        });
      });
    });
  });
</script>
