---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

// 1. Fetch and sort all active posts
const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

// 2. Define the 4 Master Categories
const libraryTags = ["essays", "deconstructions", "academia", "frameworks"];

// 3. Filter out any posts that don't belong in the Library
const libraryPosts = sortedPosts.filter(post => 
  post.data.tags.some(tag => libraryTags.includes(tag))
);
---

<Layout title={`The Library | ${SITE.title}`}>
  <Header activeNav="library" />
  
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    
    <section class="pt-8 pb-6 text-center">
      <h1 class="text-3xl font-bold tracking-wider sm:text-4xl mb-4">The Library</h1>
      <p class="text-skin-base opacity-90 max-w-2xl mx-auto leading-relaxed">
        First-principles thinking. Essays, book deconstructions, academic systems work, and operational frameworks exploring the mechanics of human behavior, physical infrastructure, and capital generation.
      </p>
    </section>

    <section class="flex flex-wrap justify-center gap-3 mb-10 border-b border-dashed border-border pb-6">
      <button class="filter-btn active px-4 py-2 text-sm font-medium border border-skin-line rounded bg-skin-accent text-skin-inverted transition-colors" data-filter="all">
        All
      </button>
      <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="essays">
        Essays & Meditations
      </button>
      <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="deconstructions">
        Book Deconstructions
      </button>
      <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="academia">
        Academic Systems
      </button>
      <button class="filter-btn px-4 py-2 text-sm font-medium border border-skin-line rounded hover:bg-skin-card transition-colors text-skin-base" data-filter="frameworks">
        Operational Tools
      </button>
    </section>

    <section id="library-feed">
      <ul>
        {libraryPosts.map(post => {
          // Identify the master category for the HTML data attribute
          const mainCategory = post.data.tags.find(tag => libraryTags.includes(tag)) || "other";
          
          return (
            <li class="post-item mb-6" data-category={mainCategory}>
              <Card {...post} />
            </li>
          );
        })}
      </ul>
    </section>
    
  </main>
  
  <Footer />
</Layout>

<script is:inline>
  function setupLibraryFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const postItems = document.querySelectorAll('.post-item');

    // Exit if elements don't exist on this page
    if (filterBtns.length === 0) return;

    filterBtns.forEach(btn => {
      // Using onclick prevents duplicate listeners if Astro reloads the page
      btn.onclick = function() {
        // 1. Reset all buttons to inactive styling
        filterBtns.forEach(b => {
          b.classList.remove('bg-skin-accent', 'text-skin-inverted');
          b.classList.add('hover:bg-skin-card', 'text-skin-base');
        });

        // 2. Highlight the clicked button
        this.classList.add('bg-skin-accent', 'text-skin-inverted');
        this.classList.remove('hover:bg-skin-card', 'text-skin-base');

        // 3. Execute the filter logic
        const filterValue = this.getAttribute('data-filter');

        postItems.forEach(item => {
          if (filterValue === 'all' || item.getAttribute('data-category') === filterValue) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      };
    });
  }

  // 1. Run immediately for direct page loads
  setupLibraryFilters();
  
  // 2. Run on standard DOM load
  document.addEventListener('DOMContentLoaded', setupLibraryFilters);
  
  // 3. Run on Astro's internal page transition routing
  document.addEventListener('astro:page-load', setupLibraryFilters);
</script>
