---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

// Pre-sort the posts into their respective categories
const transmissions = sortedPosts.filter(post => post.data.tags?.includes("transmissions"));
const deconstructions = sortedPosts.filter(post => post.data.tags?.includes("deconstructions"));
const meditations = sortedPosts.filter(post => post.data.tags?.includes("meditations"));
const academia = sortedPosts.filter(post => post.data.tags?.includes("academic-systems"));
const frameworks = sortedPosts.filter(post => post.data.tags?.includes("frameworks"));
---

<Layout title={`The Library | ${SITE.title}`}>
  <Header activeNav="library" />

  <main class="mx-auto w-full max-w-3xl px-4 pb-12">
    
    <section class="pt-8 pb-10 text-center border-b border-dashed border-border">
      <h1 class="text-3xl font-bold tracking-wider sm:text-4xl mb-4">The Library</h1>
      <p class="text-skin-base opacity-90 max-w-2xl mx-auto leading-relaxed">
        First-principles thinking. Essays, deconstructions, philosophical meditations, academic systems, and cognitive frameworks exploring human behavior, operational excellence, and long-term compounding.
      </p>
    </section>

    <div class="mt-8 space-y-12">
      
      {transmissions.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-wide text-skin-accent mb-6">Transmissions</h2>
          <ul class="space-y-6 pl-2 border-l-2 border-skin-line border-opacity-50">
            {transmissions.map(post => <li class="block"><Card {...post} /></li>)}
          </ul>
        </section>
      )}

      {deconstructions.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-wide text-skin-accent mb-6">Deconstructions</h2>
          <ul class="space-y-6 pl-2 border-l-2 border-skin-line border-opacity-50">
            {deconstructions.map(post => <li class="block"><Card {...post} /></li>)}
          </ul>
        </section>
      )}

      {meditations.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-wide text-skin-accent mb-6">Meditations</h2>
          <ul class="space-y-6 pl-2 border-l-2 border-skin-line border-opacity-50">
            {meditations.map(post => <li class="block"><Card {...post} /></li>)}
          </ul>
        </section>
      )}

      {academia.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-wide text-skin-accent mb-6">Academic Systems</h2>
          <ul class="space-y-6 pl-2 border-l-2 border-skin-line border-opacity-50">
            {academia.map(post => <li class="block"><Card {...post} /></li>)}
          </ul>
        </section>
      )}

      {frameworks.length > 0 && (
        <section>
          <h2 class="text-2xl font-bold tracking-wide text-skin-accent mb-6">Operational Frameworks</h2>
          <ul class="space-y-6 pl-2 border-l-2 border-skin-line border-opacity-50">
            {frameworks.map(post => <li class="block"><Card {...post} /></li>)}
          </ul>
        </section>
      )}

    </div>
   
  </main>

  <Footer />
</Layout>
