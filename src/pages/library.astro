---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");
const sortedPosts = getSortedPosts(posts);

// Hard Firewall: Strictly filter for posts that contain the 'library' tag
const libraryPosts = sortedPosts.filter((post) => {
  const tags = post.data.tags || [];
  return tags.includes("library");
});
---

<Layout title={`The Library | ${SITE.title}`}>
  <Header activeNav="library" />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-12 border-b border-border text-center">
      <h1 class="text-4xl font-bold">The Library</h1>
      <p class="mt-4 text-xl text-muted-foreground">
        First-Principles Philosophy. Discrete essays, book deconstructions, and cognitive frameworks exploring the intersection of human psychology and physical systems.
      </p>
    </section>

    {
      libraryPosts.length > 0 && (
        <section class="pt-8 pb-16 max-w-4xl mx-auto px-4">
          <ul class="space-y-6">
            {libraryPosts.map((post) => (
              <li><Card {...post} /></li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
