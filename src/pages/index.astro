---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured).slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
<main id="main-content" class="app-layout">
    <section id="hero" class="pb-6 pt-8">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl">{SITE.title}</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link mb-6 inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="mb-2 h-6 w-6 scale-110 fill-muted sm:mb-3 sm:scale-125">
          <path d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"></path>
          <path d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"></path>
          <circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="my-2 text-xl font-medium text-foreground">
        Integrated OS Architect
      </p>
      
      <p class="my-2">
        Systems-oriented builds in Physics, Engineering, and Business Logic. 
        Documenting the raw engineering behind the Human Machine, financial architecture, and programmatic systems.
      </p>
      
      <p class="my-2 mt-4">
        Explore <LinkButton href="/posts" class="underline decoration-dashed underline-offset-4 hover:text-accent">The Lab</LinkButton> for active builds, 
        or read first-principles essays in <LinkButton href="/library" class="underline decoration-dashed underline-offset-4 hover:text-accent">The Library</LinkButton>.
      </p>
    </section>

    <hr class="my-6 border-dashed border-border" />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pb-6 pt-12">
            <h2 class="text-2xl font-semibold tracking-wide">Featured Systems</h2>
            <ul>
              {featuredPosts.map(post => (
                <Card {...post} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <hr class="my-6 border-dashed border-border" />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-6 pt-12">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Deployments</h2>
          <ul>
            {recentPosts.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts">
        All Posts
        <svg xmlns="http://www.w3.org/2000/svg">
          <path d="m11.293 17.293 1.414 1.414L19.414 12l-6.707-6.707-1.414 1.414L15.586 11H6v2h9.586z"></path>
        </svg>
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
