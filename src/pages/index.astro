---
import Page from "@/layouts/Page.astro";
import Subscribe from "@/components/Subscribe.astro";
import { getEssays, getPostUrl, groupByYear, smartQuotes } from "@/utils/posts";

const years = groupByYear(await getEssays());
---

<Page>
  <p class="lede">
    I’ve tended bar in San Antonio since 2012. I write about money, risk, and
    how people decide when they can’t know how it will turn out.
  </p>
  <p class="lede-follow">
    In 2027 I’m putting a capped $20,000 into a year of poker to get better at
    exactly that. It’s called <a class="text-link" href="/nonzero">Nonzero</a>.
  </p>

  <h2 class="section-title">Essays</h2>
  {
    years.map(({ year, posts }) => (
      <section class="year-group" aria-label={`Essays from ${year}`}>
        <p class="year-label">{year}</p>
        <ul class="essay-list">
          {posts.map(post => (
            <li>
              <a href={getPostUrl(post)}>{smartQuotes(post.data.title)}</a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <p class="after-list">
    Older notes, market logs, and retired training programs are in the <a
      class="text-link"
      href="/archive">archive</a
    >.
  </p>

  <div class="essay-end">
    <Subscribe />
  </div>
</Page>
