---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BaseRateSignup from "@/components/BaseRateSignup.astro";
import LatestIssues from "@/components/LatestIssues.astro";

const tracks = [
  {
    href: "/newsletter",
    label: "Markets",
    name: "Base Rate",
    body: "A free weekly letter. One macro read, one lesson on how people decide, and what I changed in my own portfolio, on the record.",
    cta: "Read Base Rate",
  },
  {
    href: "/nonzero",
    label: "Poker · 2027",
    name: "Mr. Nonzero",
    body: "Twelve months of poker with a hard $20,000 cap and a public ledger. Not a gambling story. A year-long test of deciding under pressure.",
    cta: "See the rules and ledger",
  },
  {
    href: "/work",
    label: "Projects",
    name: "Work",
    body: "Project management and owner's rep work, built on the same habits: define the risk, track every dollar, grade the decision.",
    cta: "What I bring to a project",
  },
];

const startHere = [
  {
    href: "/posts/wrong-order",
    title: "Most People Build Wealth in the Wrong Order",
    note: "The sequence I use: cash flow, then compounding, then leverage.",
  },
  {
    href: "/posts/the-nonzero-year",
    title: "The Nonzero Year",
    note: "Why I'm putting $20k into a year of decisions instead of a car.",
  },
  {
    href: "/posts/how-i-invest",
    title: "How I Invest",
    note: "The rules I invest by and the metrics I watch.",
  },
];
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section id="hero" class="pt-8 pb-8 sm:pt-12">
      <p class="text-sm font-semibold tracking-widest uppercase opacity-70">
        Rudy Galan &middot; San Antonio, TX
      </p>
      <h1 class="mt-3 mb-5 text-3xl leading-tight font-bold sm:text-5xl">
        Markets, risk, and decisions.
      </h1>
      <p class="max-w-2xl text-base leading-relaxed sm:text-lg">
        I've spent 14 years behind high-volume hotel bars watching how people
        talk, negotiate, and decide, and I study markets and economics on my own
        terms. Here I publish what I see, what I'm doing about it, and how it
        turns out. No hindsight edits.
      </p>
    </section>

    <section id="newsletter" class="pb-10">
      <BaseRateSignup />
    </section>

    <LatestIssues />

    <section
      id="tracks"
      class="border-t border-dashed border-border pt-10 pb-10"
    >
      <h2 class="text-2xl font-semibold tracking-wide">
        One question, three tracks
      </h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed opacity-80">
        How do you make good decisions when you can't know the outcome? I'm
        working that out in public, in markets, at the poker table, and on real
        projects.
      </p>
      <ul class="mt-6 grid list-none grid-cols-1 gap-4 ps-0 sm:grid-cols-3">
        {
          tracks.map(track => (
            <li class="flex flex-col rounded-lg border border-border p-5">
              <p class="text-xs font-semibold tracking-widest uppercase opacity-60">
                {track.label}
              </p>
              <h3 class="mt-1 text-lg font-bold">{track.name}</h3>
              <p class="mt-2 grow text-sm leading-relaxed opacity-90">
                {track.body}
              </p>
              <a
                href={track.href}
                class="mt-4 text-sm font-medium text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
              >
                {track.cta} &rarr;
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed opacity-80">
        The brand underneath all three is
        <a
          href="/shop"
          class="font-medium underline decoration-dashed underline-offset-4 hover:text-accent"
          >Risk On</a
        >: bet on yourself, with the numbers. The shirts are for people who do.
      </p>
    </section>

    <section
      id="start-here"
      class="border-t border-dashed border-border pt-10 pb-6"
    >
      <h2 class="text-2xl font-semibold tracking-wide">
        New here? Start with these
      </h2>
      <ol class="mt-4 list-none space-y-4 ps-0">
        {
          startHere.map((item, i) => (
            <li class="flex gap-4">
              <span class="font-mono text-sm opacity-50">0{i + 1}</span>
              <div>
                <a
                  href={item.href}
                  class="font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
                >
                  {item.title}
                </a>
                <p class="text-sm opacity-80">{item.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-6 text-sm">
        <a
          href="/writing"
          class="font-medium underline decoration-dashed underline-offset-4 hover:text-accent"
        >
          All writing &rarr;
        </a>
      </p>
    </section>

    <section
      id="about-short"
      class="my-10 grid grid-cols-1 items-center gap-6 border-t border-dashed border-border pt-10 sm:grid-cols-3"
    >
      <div class="flex justify-center sm:col-span-1">
        <img
          src="/headshot.jpg"
          alt="Rudy Galan in San Antonio, Texas"
          class="h-48 w-48 rounded-full border-2 border-border object-cover shadow-sm sm:aspect-square sm:h-auto sm:w-full sm:rounded-lg"
        />
      </div>
      <div class="flex flex-col justify-center sm:col-span-2">
        <h2 class="mb-2 text-xl font-semibold">Who's writing this</h2>
        <p class="text-sm leading-relaxed opacity-90">
          I'm a bartender, not a credentialed insider. I left school on purpose
          and treat real projects as the curriculum: my own portfolio, real
          estate deals, this site, and a year of poker. I'm pursuing the CAPM,
          Oracle Primavera P6, and the Series 65, building toward owner's rep
          work in energy and infrastructure and a market-analysis practice of my
          own.
        </p>
        <p class="mt-3 text-sm">
          <a
            href="/about"
            class="font-medium text-accent underline decoration-dashed underline-offset-4 hover:decoration-solid"
          >
            The full story &rarr;
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
