---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";

// 1. Fetch all published posts (excluding drafts)
const posts = await getCollection("blog", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);

// 2. Define the tags reserved EXCLUSIVELY for The Library
const libraryTags = ["transmissions", "deconstructions", "academic-systems"];

// 3. The Firewall: Filter OUT any post that contains a Library tag
const labPosts = sortedPosts.filter(post => 
  !post.data.tags?.some(tag => libraryTags.includes(tag))
);

// 4. Feed ONLY the remaining operator logs into your Featured and Recent sections
const featuredPosts = labPosts.filter(({ data }) => data.featured);
const recentPosts = labPosts.filter(({ data }) => !data.featured).slice(0, SITE.postPerIndex);
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section id="hero" class="pb-6 pt-8">
      <h1 class="my-4 inline-block text-3xl font-bold sm:my-8 sm:text-5xl">Systems Builder & Operator</h1>
      
      <a  target="_blank"
        href="/rss.xml"
        class="rss-link mb-6 inline-block"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="mb-2 h-6 w-6 scale-110 fill-muted sm:mb-3 sm:scale-125">
          <path d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"></path>
          <path d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"></path>
          <circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>
      
      <p class="my-2 text-base leading-relaxed">
        This site is where I document what I'm building — practical systems for money, training, and the physics underneath both. No filler, just what's actually working.
      </p>

      <p class="my-2 text-base leading-relaxed font-semibold text-skin-accent">
        <LinkButton href="/posts/wrong-order" class="hover:underline underline-offset-4">
          New here? Start with the order most people get wrong →
        </LinkButton>
      </p>
      
      <p class="my-2 mt-4">
        Track active builds in <span class="whitespace-nowrap"><LinkButton href="/posts" class="underline decoration-dashed underline-offset-4 hover:text-accent">The Lab</LinkButton>,</span> read core essays in <span class="whitespace-nowrap"><LinkButton href="/library" class="underline decoration-dashed underline-offset-4 hover:text-accent">The Library</LinkButton>,</span> or check out physical goods in the <span class="whitespace-nowrap"><LinkButton href="/shop" class="underline decoration-dashed underline-offset-4 hover:text-accent">Shop</LinkButton></span>.
      </p>
    </section>

    <hr class="my-6 border-dashed border-border" />

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pb-6 pt-12">
            <h2 class="text-2xl font-semibold tracking-wide">Featured Systems</h2>
            <ul>
              {featuredPosts.map(post => (
                <Card {...post} />
              ))}
            </ul>
          </section>
          {recentPosts.length > 0 && <hr class="my-6 border-dashed border-border" />}
        </>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-6 pt-12">
          <h2 class="text-2xl font-semibold tracking-wide">Recent Deployments</h2>
          <ul>
            {recentPosts.map(post => (
              <Card {...post} />
            ))}
          </ul>
        </section>
      )
    }

    <section id="operator-profile" class="my-6 grid grid-cols-1 gap-6 items-center border-t border-dashed border-border pt-8 sm:grid-cols-3">
      <div class="flex justify-center sm:col-span-1">
        <img 
          src="/headshot.jpg" 
          alt="Rudy Galan, professional operator and systems builder in San Antonio, Texas" 
          class="w-48 h-48 rounded-full object-cover border-2 border-skin-line bg-skin-card shadow-sm sm:w-full sm:h-auto sm:aspect-square sm:rounded-lg"
        />
      </div>
      <div class="sm:col-span-2 flex flex-col justify-center">
        <h3 class="text-xl font-semibold text-skin-base mb-2">Meet the Operator</h3>
        <p class="text-sm leading-relaxed text-skin-base opacity-90">
          Over a decade in high-volume hospitality funded 150+ credits in STEM — biology, physics, and economics — plus my own investing. Curiosity and an internet connection funded the rest. I'm building toward project management in large-scale energy infrastructure — the physical backbone the next economy will actually run on.
        </p>
        <p class="text-sm mt-3">
          <LinkButton href="/about" class="text-skin-accent font-medium hover:underline inline-flex items-center gap-1">
            Read the full brief
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </LinkButton>
        </p>
      </div>
    </section>

  </main>

  <Footer />
</Layout>