---
import Layout from "./Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  article?: boolean;
};

const props = Astro.props;
---

<Layout {...props}>
  <Header />
  <main id="main-content" class="frame site-main">
    <slot />
  </main>
  <Footer />
</Layout>
