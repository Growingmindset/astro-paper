---
import issues from "@/data/base-rate-issues.json";
import { BASE_RATE } from "@/config";

type Props = { limit?: number; heading?: string };
const { limit = 3, heading = "Latest from Base Rate" } = Astro.props;

const fmt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const items = (
  issues as { title: string; url: string; date: string; summary: string }[]
).slice(0, limit);
---

{
  items.length > 0 && (
    <section class="border-t border-dashed border-border pt-10 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide">{heading}</h2>
      <ul class="mt-4 list-none space-y-4 ps-0">
        {items.map(issue => (
          <li>
            <a
              href={issue.url}
              target="_blank"
              rel="noopener"
              class="font-medium text-accent decoration-dashed underline-offset-4 hover:underline"
            >
              {issue.title}
            </a>
            {issue.date && (
              <span class="ms-2 text-xs opacity-60">
                {fmt.format(new Date(issue.date))}
              </span>
            )}
            {issue.summary && <p class="text-sm opacity-80">{issue.summary}</p>}
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm">
        <a
          href={BASE_RATE.url}
          target="_blank"
          rel="noopener"
          class="font-medium underline decoration-dashed underline-offset-4 hover:text-accent"
        >
          All editions &rarr;
        </a>
      </p>
    </section>
  )
}
