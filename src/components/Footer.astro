import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
 
const currentYear = new Date().getFullYear();
 
type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;
 
const { noMarginTop = false, class: className, ...attrs } = Astro.props;
 
// TREC Rules 531.18 / 531.20(b): both links must appear on the homepage,
// in a readily noticeable place, using one of two label/size pairs:
//   - full label ("Texas Real Estate Commission ...") at 10pt minimum, or
//   - short label ("TREC ...") at 12pt minimum
// Using the short labels here since they take less room, so the two links
// below are pinned to text-base (16px = 12pt) on purpose — don't shrink
// this specific block with a smaller text-size class.
const IABS_URL =
  "https://drive.google.com/file/d/1cTMRql8JOueF2ipH6R5OWF6csYdnyqyp/view?usp=sharing";
const CPN_URL = "https://www.trec.texas.gov/forms/consumer-protection-notice";
---
 
<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-6 sm:py-4",
      "border-t border-border",
      "flex flex-col items-center justify-between sm:flex-row-reverse",
    ]}
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>
 
  <div class="text-foreground/70 pb-6 text-center text-base sm:pb-4">
    <a
      href={IABS_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-foreground underline underline-offset-2"
    >
      TREC Information About Brokerage Services
    </a>
    <span class="opacity-50" aria-hidden="true">&nbsp;&middot;&nbsp;</span>
    <a
      href={CPN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-foreground underline underline-offset-2"
    >
      TREC Consumer Protection Notice
    </a>
  </div>
</footer>
 
