---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

// TREC Rules 531.18 / 531.20(b): both links must appear on the homepage,
// in a readily noticeable place, using one of two label/size pairs:
//   - full label ("Texas Real Estate Commission ...") at 10pt minimum, or
//   - short label ("TREC ...") at 12pt minimum
// Using the short labels here since they take less room, so the two links
// below are pinned to text-base (16px = 12pt) on purpose — don't shrink
// this specific block with a smaller text-size class.
const IABS_URL =
  "https://drive.google.com/file/d/1cTMRql8JOueF2ipH6R5OWF6csYdnyqyp/view?usp=sharing";
const CPN_URL = "https://www.trec.texas.gov/forms/consumer-protection-notice";
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class:list={[
      "py-6 sm:py-4",
      "border-t border-border",
      "flex flex-col items-center justify-between sm:flex-row-reverse",
    ]}
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>Copyright &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>All rights reserved.</span>
    </div>
  </div>

  <nav
    aria-label="Secondary"
    class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 pb-4 text-sm"
  >
    <a href="/shop" class="underline-offset-4 hover:text-accent hover:underline"
      >Shop: Risk On</a
    >
    <a
      href="/archive"
      class="underline-offset-4 hover:text-accent hover:underline">Archive</a
    >
    <a
      href="/rss.xml"
      class="underline-offset-4 hover:text-accent hover:underline">RSS</a
    >
  </nav>

  <p
    class="mx-auto max-w-2xl pb-4 text-center text-xs leading-relaxed text-foreground/70"
  >
    Educational content only, not investment, legal, or tax advice.
    <a
      href="/newsletter#disclosure"
      class="underline underline-offset-2 hover:text-accent">Full disclosure</a
    >
  </p>

  <div class="pb-6 text-center text-base text-foreground/70 sm:pb-4">
    <a
      href={IABS_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-2 hover:text-foreground"
    >
      TREC Information About Brokerage Services
    </a>
    <span class="opacity-50" aria-hidden="true">&nbsp;&middot;&nbsp;</span>
    <a
      href={CPN_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-2 hover:text-foreground"
    >
      TREC Consumer Protection Notice
    </a>
  </div>
</footer>
