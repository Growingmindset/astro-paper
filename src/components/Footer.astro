---
import { CONTACT, SITE } from "@/config";

const year = new Date().getFullYear();

// TREC Rules 531.18 / 531.20(b): a Texas license holder's business website
// must link both notices from the home page, in a readily noticeable place.
// They sit on every page here so they can never be missed. See .trec-links
// in global.css for the size requirement.
const IABS_URL =
  "https://drive.google.com/file/d/1cTMRql8JOueF2ipH6R5OWF6csYdnyqyp/view?usp=sharing";
const CPN_URL = "https://www.trec.texas.gov/forms/consumer-protection-notice";
---

<footer class="frame site-footer">
  <div class="footer-inner">
    <div class="footer-row footer-links">
      <a href={`mailto:${CONTACT.email}`}>Email</a>
      <a href={CONTACT.x} rel="me">X</a>
      <a href={CONTACT.linkedin} rel="me">LinkedIn</a>
      <a href="/archive">Archive</a>
      <a href="/rss.xml">RSS</a>
    </div>
    <p class="footer-row">&copy; {year} {SITE.author}</p>
    <p class="footer-row footer-links trec-links">
      <a href={IABS_URL} target="_blank" rel="noopener noreferrer"
        >TREC Information About Brokerage Services</a
      >
      <a href={CPN_URL} target="_blank" rel="noopener noreferrer"
        >TREC Consumer Protection Notice</a
      >
    </p>
  </div>
</footer>
