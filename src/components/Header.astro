---
import { SITE, navLinks } from "@/config";

// Older pages pass props such as `activeNav`; they're accepted and ignored.
type Props = Record<string, unknown>;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) =>
  path === href || path.startsWith(`${href}/`);
---

<a
  href="#main-content"
  class="absolute -top-full left-4 z-50 bg-background px-3 py-2 focus:top-4"
>
  Skip to content
</a>

<header class="frame site-header">
  <a href="/" class="site-name" aria-current={path === "/" ? "page" : undefined}
    >{SITE.title}</a
  >
  <nav class="site-nav" aria-label="Main">
    {
      navLinks.map(link => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href) ? "page" : undefined}
        >
          {link.linkText}
        </a>
      ))
    }
  </nav>
</header>
